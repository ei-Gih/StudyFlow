# ─────────────────────────────────────────────────────────────
# StudyFlow — .env.local
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite este arquivo no repositório
# ─────────────────────────────────────────────────────────────

# ── Banco de dados ────────────────────────────────────────────
# Postgres local (desenvolvimento):
DATABASE_URL="postgresql://studyflow:studyflow@localhost:5432/studyflow_dev"

# Postgres via Docker Compose:
# DATABASE_URL="postgresql://studyflow:studyflow@db:5432/studyflow_dev"

# Produção (ex: Supabase, Neon, Railway):
# DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB?sslmode=require"

# ── NextAuth ──────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="TROQUE_POR_SEGREDO_FORTE_AQUI"
NEXTAUTH_URL="http://localhost:3000"

# ── OAuth (opcional) ─────────────────────────────────────────
# Google: https://console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Redis (opcional — para cache e rate limiting) ─────────────
# REDIS_URL="redis://localhost:6379"

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="StudyFlow"
NODE_ENV="development"
